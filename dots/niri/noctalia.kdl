layout {

    focus-ring {
        active-color   "#b4ff00"
        inactive-color "#080b08"
        urgent-color   "#ff4d1f"
    }

    border {
        active-color   "#b4ff00"
        inactive-color "#080b08"
        urgent-color   "#ff4d1f"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b4ff00"
        inactive-color "#364d00"
        urgent-color   "#ff4d1f"
    }

    insert-hint {
        color "#b4ff0080"
    }
}

recent-windows {
    highlight {
        active-color "#b4ff00"
        urgent-color "#ff4d1f"
    }
}
