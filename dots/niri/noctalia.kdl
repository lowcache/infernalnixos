layout {

    focus-ring {
        active-color   "#f5c2e7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    border {
        active-color   "#f5c2e7"
        inactive-color "#1e1e2e"
        urgent-color   "#f38ba8"
    }

    shadow {
        color "#11111b70"
    }

    tab-indicator {
        active-color   "#f5c2e7"
        inactive-color "#ef16b3"
        urgent-color   "#f38ba8"
    }

    insert-hint {
        color "#f5c2e780"
    }
}

recent-windows {
    highlight {
        active-color "#f5c2e7"
        urgent-color "#f38ba8"
    }
}
