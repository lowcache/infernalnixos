layout {

    focus-ring {
        active-color   "#aad71e"
        inactive-color "#151515"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aad71e"
        inactive-color "#151515"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#aad71e"
        inactive-color "#384904"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aad71e80"
    }
}

recent-windows {
    highlight {
        active-color "#aad71e"
        urgent-color "#ffb4ab"
    }
}
