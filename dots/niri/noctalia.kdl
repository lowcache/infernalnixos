layout {

    focus-ring {
        active-color   "#d95757"
        inactive-color "#0b0e14"
        urgent-color   "#aad94c"
    }

    border {
        active-color   "#d95757"
        inactive-color "#0b0e14"
        urgent-color   "#aad94c"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#d95757"
        inactive-color "#700e0e"
        urgent-color   "#aad94c"
    }

    insert-hint {
        color "#d9575780"
    }
}

recent-windows {
    highlight {
        active-color "#d95757"
        urgent-color "#aad94c"
    }
}
