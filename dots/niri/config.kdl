// Vol NixOS — niri compositor config (INERT until symlinked via home/persist.nix in Phase 1).
// niri 25.11 (KDL). Validate next session with: niri validate -c dots/niri/config.kdl
// Noctalia v5 is the shell/bar — launched via spawn-at-startup below.

input {
    keyboard {
        xkb { layout "us" }
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {}
    // Focus follows mouse can be enabled later; left off to match current ii habits.
}

// Outputs: niri auto-detects. Add explicit blocks after `niri msg outputs` next session.
// output "eDP-1" { mode "1920x1080@60.000"; scale 1.0 }

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
    }
    border {
        off
    }
}

// --- Startup: launch Noctalia v5 shell (bar, control center, panels) ---
spawn-at-startup "noctalia"
// Wallpaper/portals are handled by Noctalia + the NixOS xdg.portal config.

prefer-no-csd
screenshot-path "~/Storage/screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Quake terminal: floating kitty (app-id "quake"), toggled by the niri-port script.
window-rule {
    match app-id="^quake$"
    open-floating true
    default-column-width { proportion 0.98; }
}

binds {
    // --- Session / shell ---
    Mod+Return       { spawn "kitty"; }
    Mod+Space        { spawn "fuzzel"; }        // or noctalia's launcher once mapped
    Mod+Q            { close-window; }
    Mod+Grave        { spawn "bash" "-c" "~/.config/niri/scripts/quake_toggle.sh toggle"; }

    // --- Focus / movement (scrollable tiling) ---
    Mod+H            { focus-column-left; }
    Mod+L            { focus-column-right; }
    Mod+J            { focus-window-down; }
    Mod+K            { focus-window-up; }
    Mod+Shift+H      { move-column-left; }
    Mod+Shift+L      { move-column-right; }
    Mod+Shift+J      { move-window-down; }
    Mod+Shift+K      { move-window-up; }

    // --- Columns / windows ---
    Mod+R            { switch-preset-column-width; }
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+V            { toggle-window-floating; }
    Mod+W            { toggle-column-tabbed-display; }

    // --- Workspaces ---
    Mod+1            { focus-workspace 1; }
    Mod+2            { focus-workspace 2; }
    Mod+3            { focus-workspace 3; }
    Mod+4            { focus-workspace 4; }
    Mod+5            { focus-workspace 5; }
    Mod+Shift+1      { move-column-to-workspace 1; }
    Mod+Shift+2      { move-column-to-workspace 2; }
    Mod+Shift+3      { move-column-to-workspace 3; }
    Mod+Shift+4      { move-column-to-workspace 4; }
    Mod+Shift+5      { move-column-to-workspace 5; }
    Mod+Page_Down    { focus-workspace-down; }
    Mod+Page_Up      { focus-workspace-up; }

    // --- Screenshot ---
    Print            { screenshot; }
    Mod+Print        { screenshot-window; }

    // --- Session control ---
    Mod+Shift+E      { quit; }
    Mod+Shift+P      { power-off-monitors; }
}
